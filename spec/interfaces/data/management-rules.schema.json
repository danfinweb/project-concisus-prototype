{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data/management-rules.schema.json",
  "title": "Management rules",
  "description": "Global management constants (spec MGT). The weight to AP/stamina penalty is TAC-027 (tactical-rules); the pay interval and running-cost formulas are economy-rules (MGT-073).",
  "version": "0.6.0",
  "$comment": "Named constants. Fields are optional until the content pass fills them with the design placeholders listed in the spec.",
  "type": "object",
  "$defs": {
    "intRange": { "type": "object", "properties": { "min": { "type": "integer" }, "max": { "type": "integer" } }, "additionalProperties": false },
    "fraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "usd": { "type": "number", "minimum": 0 }
  },
  "properties": {
    "moraleStart": { "type": "integer", "minimum": 0, "maximum": 100, "description": "MGT-008, design 80 (per soldier at hiring)" },
    "moraleFleeBelow": { "type": "integer", "minimum": 0, "maximum": 100, "description": "MGT-008 (optional), design 20" },
    "attributeMin": { "type": "integer", "description": "MGT-021, design 1" },
    "attributeMax": { "type": "integer", "description": "MGT-021, design 100" },
    "skillGrowth": {
      "type": "object", "description": "MGT-023",
      "properties": {
        "fastBelow": { "type": "integer", "minimum": 1, "maximum": 100, "description": "design 50" },
        "slowAbove": { "type": "integer", "minimum": 1, "maximum": 100, "description": "design 80" },
        "xpPerUse": { "type": "number", "exclusiveMinimum": 0, "description": "design draft 1 xp per use" },
        "xpPerPoint": {
          "type": "object", "description": "xp cost of the next skill point by band, design draft fast 5 (below 50), medium 10 (50-80), slow 20 (above 80)",
          "properties": {
            "fast": { "type": "number", "exclusiveMinimum": 0 },
            "medium": { "type": "number", "exclusiveMinimum": 0 },
            "slow": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "physicalChange": {
      "type": "object", "description": "MGT-024: magnitude of one physical-attribute change event, design draft 1..5",
      "properties": { "min": { "type": "integer", "minimum": 0 }, "max": { "type": "integer", "minimum": 0 } },
      "additionalProperties": false
    },
    "physicalChanges": { "type": "array", "description": "MGT-024: event conditions, attribute and sign, not set" },
    "skillDrift": {
      "type": "object", "description": "MGT-025 (optional): lose points per idleDays unused, never below the hired value",
      "properties": {
        "points": { "type": "integer", "minimum": 0, "description": "design draft 1" },
        "idleDays": { "type": "integer", "minimum": 1, "description": "design draft 14" }
      },
      "additionalProperties": false
    },
    "perkThresholds": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 100 }, "description": "MGT-009, design draft [50, 80] (one perk per skill at each)" },
    "perks": {
      "type": "array", "description": "MGT-009: perk list, not set",
      "items": {
        "type": "object", "required": ["id", "attribute", "threshold"],
        "properties": {
          "id": { "type": "string" },
          "attribute": { "enum": ["marksmanship", "recon", "medical", "technical"] },
          "threshold": { "type": "integer", "minimum": 1, "maximum": 100 },
          "effect": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "carryCapacity": {
      "type": "object", "description": "MGT-029, draft {base 15, strength 0.3, endurance 0.1} kg",
      "properties": { "base": { "type": "number" }, "strength": { "type": "number" }, "endurance": { "type": "number" } },
      "additionalProperties": false
    },
    "nerve": {
      "type": "object", "description": "MGT-031, design draft 0..100, start 0, +2 per deployment survived, +1 per fight under fire",
      "properties": {
        "min": { "type": "integer" },
        "max": { "type": "integer" },
        "start": { "type": "integer" },
        "perDeployment": { "type": "number", "minimum": 0 },
        "perFightUnderFire": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "insurance": {
      "type": "object", "description": "MGT-036, design draft premium 10% of value per op, 50% recovery after 3 days",
      "properties": {
        "premiumFraction": { "$ref": "#/$defs/fraction" },
        "recoveryChance": { "$ref": "#/$defs/fraction" },
        "delayDays": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "scavLoadout": {
      "type": "object", "description": "MGT-038: the always-purchasable scav loadout (only owner of its contents and price); design draft used AK-74M, 2 magazines, tourniquet, no armour, $500",
      "properties": {
        "items": { "type": "array", "items": { "type": "object", "required": ["item"], "properties": { "item": { "type": "string", "x-ref": "items" }, "count": { "type": "integer", "minimum": 1 } }, "additionalProperties": false } },
        "priceUsd": { "$ref": "#/$defs/usd" },
        "weaponCondition": { "type": "integer", "minimum": 0, "maximum": 100, "description": "condition of the used weapon, not set" }
      },
      "additionalProperties": false
    },
    "lowRiskContract": {
      "type": "object", "description": "MGT-038, design draft: a retrieve_deliver mission away from the front, against no faction",
      "properties": {
        "missionId": { "type": "string", "x-ref": "missions" },
        "targetFaction": { "type": "null" },
        "minFrontDistance": { "type": "integer", "minimum": 0, "description": "tiles from the nearest front tile, not set" }
      },
      "additionalProperties": false
    },
    "weaponRepair": { "type": "object", "description": "DAT-014, MGT-067: condition restored per soldier repair and its Technical scaling, not set" },
    "advanceFraction": { "$ref": "#/$defs/fraction", "description": "MGT-047, design 0.25" },
    "repMin": { "type": "integer", "description": "MGT-053, design -100" },
    "repMax": { "type": "integer", "description": "MGT-053, design 100" },
    "repStart": { "type": "integer", "description": "MGT-053, design 0" },
    "standingThresholds": {
      "type": "object", "description": "MGT-054: hostile if r <= hostile, unfriendly if r <= unfriendly, friendly if r >= friendly, trusted if r >= trusted, else neutral; the only low-reputation thresholds (SAI-013 uses the derived standing)",
      "properties": {
        "hostile": { "type": "integer", "description": "design -50" },
        "unfriendly": { "type": "integer", "description": "design -20" },
        "friendly": { "type": "integer", "description": "design 20" },
        "trusted": { "type": "integer", "description": "design 50" }
      },
      "additionalProperties": false
    },
    "repActs": {
      "type": "object", "description": "MGT-056..MGT-059: reputation change per act (directly affected faction only, MGT-060); keys are the management_requests reputationAct names",
      "properties": {
        "missionSuccess": { "$ref": "#/$defs/intRange", "description": "MGT-056, design +5..+15 (range check for missionSuccessByPay)" },
        "missionSuccessByPay": {
          "type": "array", "description": "MGT-056: gain per mission completed; the highest band with minUsd <= mission pay applies; design draft [{0,5},{8000,10},{15001,15}]",
          "items": { "type": "object", "required": ["minUsd", "gain"], "properties": { "minUsd": { "$ref": "#/$defs/usd" }, "gain": { "type": "integer" } }, "additionalProperties": false }
        },
        "missionFailed": { "type": "integer", "description": "MGT-056, design -5" },
        "contractBroken": { "type": "integer", "description": "MGT-056, design -30" },
        "joinFight": { "type": "integer", "description": "MGT-057, design +5" },
        "rescue": { "type": "integer", "description": "MGT-057, design +10" },
        "sellSupplies": { "$ref": "#/$defs/intRange", "description": "MGT-057, design +1..+3 per sale" },
        "sellSuppliesUsdPerPoint": { "type": "number", "exclusiveMinimum": 0, "description": "MGT-057, design draft $1,000 of needed supplies per +1" },
        "krugKeepDeal": { "type": "integer", "description": "MGT-057, design +5" },
        "attackNonHostile": { "type": "integer", "description": "MGT-058, design -30" },
        "killSoldier": { "type": "integer", "description": "MGT-058, design -2" },
        "killCapPerFight": { "type": "integer", "description": "MGT-058, design -20" },
        "cargo": { "type": "integer", "description": "MGT-058, design -10" },
        "captureVip": { "type": "integer", "description": "MGT-058, design -20" },
        "assassinateVip": { "type": "integer", "description": "MGT-058, design -30" },
        "takeRegion": { "type": "integer", "description": "MGT-058, design -15" },
        "krugBreak": { "type": "integer", "description": "MGT-058, design -50" },
        "warCrime": { "type": "integer", "description": "MGT-059, design -20" }
      },
      "additionalProperties": false
    },
    "unfriendlyContractShare": { "$ref": "#/$defs/fraction", "description": "MGT-051, share of basic offers shown at Unfriendly, design draft 0.5" },
    "unfriendlyPriceMarkup": { "type": "number", "minimum": 0, "description": "MGT-039, price x (1 + markup) at Unfriendly, design draft 0.25" },
    "fobPrices": { "type": "object", "description": "MGT-066, per city size, not set", "additionalProperties": { "$ref": "#/$defs/usd" } },
    "servicePrices": {
      "type": "object", "description": "MGT-067, design draft hospital $300 per wound, repair $20 per condition point, fuel $50 per unit",
      "properties": {
        "hospitalPerWoundUsd": { "$ref": "#/$defs/usd" },
        "repairPerConditionPointUsd": { "$ref": "#/$defs/usd" },
        "fuelPerUnitUsd": { "$ref": "#/$defs/usd" }
      },
      "additionalProperties": false
    },
    "scoreWeights": {
      "type": "object", "description": "MGT-071, design draft funds / 1000 + sum of positive reputations + 50 per surviving soldier",
      "properties": {
        "usdPerPoint": { "type": "number", "exclusiveMinimum": 0 },
        "perSurvivingSoldier": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
