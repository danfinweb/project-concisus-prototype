{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data/recruitment.schema.json",
  "title": "Recruitment",
  "description": "Hiring pools, price tiers and salaries (spec MGT-002..MGT-005, MGT-022). The pay interval is economy-rules.payIntervalHours.",
  "version": "0.4.0",
  "$comment": "Named constants. Fields are optional until the content pass fills them with the design placeholders listed in the spec.",
  "type": "object",
  "$defs": {
    "tierId": { "enum": ["recruit", "regular", "veteran", "elite"] }
  },
  "properties": {
    "pools": {
      "type": "array", "description": "MGT-002: tiers and candidates per pool, refresh interval, not set",
      "items": {
        "type": "object", "required": ["id"],
        "properties": {
          "id": { "enum": ["agency", "local", "defector", "freedPrisoner"] },
          "tiers": { "type": "array", "items": { "$ref": "#/$defs/tierId" } },
          "candidates": { "type": "integer", "minimum": 1 },
          "refreshHours": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "tiers": {
      "type": "array", "description": "MGT-002 / MGT-003 / MGT-005, design draft recruit $1,000 / $50 / 20-45; regular $3,000 / $100 / 35-60; veteran $8,000 / $200 / 50-75; elite $20,000 / $400 / 65-90",
      "items": {
        "type": "object", "required": ["id", "hirePriceUsd", "salaryPerDayUsd", "attributeRange"],
        "properties": {
          "id": { "$ref": "#/$defs/tierId" },
          "hirePriceUsd": { "type": "number", "minimum": 0 },
          "salaryPerDayUsd": { "type": "number", "minimum": 0 },
          "attributeRange": {
            "type": "object", "required": ["min", "max"],
            "properties": { "min": { "type": "integer", "minimum": 1, "maximum": 100 }, "max": { "type": "integer", "minimum": 1, "maximum": 100 } },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "priceFormula": { "type": "object", "description": "MGT-003: scaling of the hire price with the average attribute within a tier, not set" },
    "attributeDistribution": { "type": "object", "description": "MGT-022: distribution within the tier range, not set" },
    "contractTermHours": { "type": "integer", "minimum": 1, "description": "MGT-005, design draft 720 (30 days)" },
    "nonPayment": { "type": "object", "description": "MGT-005: consequence of unpaid salaries, not set (design names the rule without defining it)" }
  },
  "additionalProperties": false
}
