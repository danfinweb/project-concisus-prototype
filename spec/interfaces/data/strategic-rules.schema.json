{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data/strategic-rules.schema.json",
  "title": "Strategic rules",
  "description": "Global strategic constants (spec STR).",
  "version": "0.3.0",
  "$comment": "Named constants. Fields are optional until the content pass fills them with the design placeholders listed in the spec.",
  "type": "object",
  "properties": {
    "capitalHoldDays": { "type": "integer", "description": "STR-007, draft 7" },
    "krugEscortPrice": { "type": "object", "description": "STR-094, not set" },
    "krugEscortHireHours": { "type": "integer", "description": "STR-094, not set" },
    "roadVisibility": { "type": "object", "description": "STR-006, asphalt / dirt visibility class" },
    "startHour": { "type": "integer", "description": "STR-001, hour of Day 1, not set" },
    "factionTickOrder": { "type": "array", "items": { "type": "string", "x-ref": "factions" }, "description": "STR-003, order in which factions act each hour" },
    "historyDays": { "type": "integer", "description": "STR-068, design 7" },
    "moveHours": { "type": "object", "description": "STR-006/STR-032: per terrain {vehicle, foot} hours (destination tile), plus one road entry (asphalt = dirt)" },
    "terrainVisibility": { "type": "object", "description": "STR-008, per terrain" },
    "offroadReduction": { "type": "object", "description": "STR-032, per off-road rating {steppe, woods}" },
    "fuelPerRegion": { "type": "integer", "description": "STR-032" },
    "heliMoveHours": { "type": "integer", "description": "STR-034, design 1" },
    "pilotTechnicalMin": { "type": "integer", "description": "STR-034, design 50" },
    "reconRange": { "type": "object", "description": "STR-008: squad, fob, intel ranges in regions" },
    "noiseRange": { "type": "object", "description": "STR-008: per noise class, regions" },
    "loyaltyMin": { "type": "integer", "description": "STR-009, design -100" },
    "loyaltyMax": { "type": "integer", "description": "STR-009, design 100" },
    "loyaltyStart": { "type": "integer", "description": "STR-009" },
    "battleHours": { "type": "integer", "description": "STR-023, design 1" },
    "scoutHours": { "type": "integer", "description": "STR-036, design 3 (placeholder)" },
    "actionHours": { "type": "object", "description": "STR-028..STR-043: launch, land, enterPoi, station, acceptContract, handOver, handIn, hospital, repair, refuel, buyFob, buyIntel, evade, krugPass (not set)" },
    "evadeChance": { "type": "object", "description": "STR-024: base, reconWeight, terrain modifiers" },
    "krugPassPrice": { "type": "integer", "description": "STR-025, not set" },
    "autoResolve": { "type": "object", "description": "STR-026: strength and gear weights, terrain modifiers" },
    "vip": { "type": "object", "description": "STR-045..STR-049: guard per rank, shock radius, morale loss per quality, intel hours (72), intel prices and standing gates" },
    "relationMin": { "type": "integer", "description": "STR-051, design -100" },
    "relationMax": { "type": "integer", "description": "STR-051, design 100" },
    "hostileAt": { "type": "integer", "description": "STR-051, design -50" },
    "alliedAt": { "type": "integer", "description": "STR-051, design 50" },
    "crisis": { "type": "object", "description": "STR-069: thresholds for the ten crisis signs" },
    "measureSignsMin": { "type": "integer", "description": "STR-070" },
    "nuclearSignsMin": { "type": "integer", "description": "STR-080, design 5" }
  },
  "additionalProperties": false
}
