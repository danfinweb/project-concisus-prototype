{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data/items.schema.json",
  "title": "Items",
  "description": "All carried and tradeable things, keyed by ID: weapons, mods, calibres, ammunition loads, helmets, body armour, vests, belts, backpacks, medical, barter and operation/faction items. Calibres and ammo loads live here with a kind field (DAT-001). Spec: DAT-001..DAT-023, DAT-030, ITM-001..ITM-034. valueUsd is the full faction-trader price (ITM-034).",
  "version": "0.8.0",
  "type": "object",
  "additionalProperties": { "$ref": "#/$defs/item" },
  "$defs": {
    "ref": { "type": "string", "x-ref": "items" },
    "zone": { "enum": ["head", "thorax", "leftArm", "rightArm", "leftLeg", "rightLeg"] },
    "armourClass": { "type": "integer", "minimum": 1, "maximum": 6 },
    "rarity": { "enum": ["common", "uncommon", "rare"] },
    "item": {
      "type": "object",
      "required": ["id", "kind", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "kind": { "enum": ["weapon", "mod", "calibre", "ammo", "helmet", "bodyArmour", "vest", "belt", "backpack", "medical", "barter", "opItem", "magazine", "grenade"] },
        "name": { "type": "string", "minLength": 1 },
        "weightKg": { "type": "number", "minimum": 0 },
        "valueUsd": { "type": "number", "minimum": 0, "description": "DAT-002 / ITM-034: full price at a faction trader = full barter value; base price at Krug markets; ammo: price per round (ITM-003); opItem: only the four items traders sell" },
        "rarity": { "$ref": "#/$defs/rarity" },
        "notes": { "type": "string" }
      },
      "oneOf": [
        { "$ref": "#/$defs/weapon" }, { "$ref": "#/$defs/mod" }, { "$ref": "#/$defs/calibre" }, { "$ref": "#/$defs/ammo" },
        { "$ref": "#/$defs/helmet" }, { "$ref": "#/$defs/bodyArmour" }, { "$ref": "#/$defs/vest" }, { "$ref": "#/$defs/belt" },
        { "$ref": "#/$defs/backpack" }, { "$ref": "#/$defs/medical" }, { "$ref": "#/$defs/barter" }, { "$ref": "#/$defs/opItem" },
        { "$ref": "#/$defs/magazine" }, { "$ref": "#/$defs/grenade" }
      ]
    },
    "weapon": {
      "properties": {
        "kind": { "const": "weapon" },
        "weaponType": { "enum": ["pistol", "shotgun", "smg", "assaultRifle", "battleRifle", "dmr", "sniperRifle", "lmg"] },
        "calibre": { "$ref": "#/$defs/ref" },
        "fireModes": { "type": "array", "minItems": 1, "items": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "const": "auto" }] } },
        "magazineSize": { "type": "integer", "minimum": 1 },
        "barrelMultiplier": { "type": "number", "exclusiveMinimum": 0 },
        "ergonomics": { "type": "integer", "minimum": 1, "maximum": 100 },
        "baseMoa": { "type": "number", "exclusiveMinimum": 0 },
        "weightKg": { "type": "number", "exclusiveMinimum": 0 },
        "recoil": { "type": "integer", "minimum": 1, "maximum": 100 },
        "modSlots": { "type": "array", "items": { "enum": ["muzzle", "stock", "pistolGrip", "optic", "handguard"] }, "description": "DAT-011: no magazine slot (magazines are items, DAT-030)" },
        "action": { "enum": ["pump", "bolt"] },
        "feedType": { "enum": ["pistol", "boxMagazine", "stripperClip", "boltAction", "belt", "tube"], "description": "Selects the reload base AP (TAC-041, DAT-011)" },
        "fireApCost": { "type": "integer", "minimum": 1, "description": "Overrides the weapon-type default fire AP (TAC-039)" }
      },
      "required": ["weaponType", "calibre", "fireModes", "magazineSize", "barrelMultiplier", "ergonomics", "baseMoa", "weightKg", "recoil", "modSlots", "feedType"]
    },
    "mod": {
      "properties": {
        "kind": { "const": "mod" },
        "slot": { "enum": ["muzzle", "stock", "pistolGrip", "optic", "handguard", "frontGrip", "tactical"] },
        "fits": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ref" }, "description": "DAT-016: the weapons this mod fits" },
        "modifiers": { "type": "object", "description": "Allowed keys per slot: see the oneOf below (DAT-016); spread and recoil modifiers multiply, ergonomics adds" },
        "suppressor": { "type": "boolean" },
        "subSlots": { "type": "object", "properties": { "frontGrip": { "type": "integer", "minimum": 0, "maximum": 1 }, "tactical": { "type": "integer", "minimum": 1, "maximum": 2 } } },
        "module": { "enum": ["flashlight", "laser"] }
      },
      "required": ["slot", "weightKg"],
      "oneOf": [
        { "description": "DAT-016 muzzle", "properties": { "slot": { "const": "muzzle" }, "modifiers": { "$ref": "#/$defs/modifiersMuzzle" } } },
        { "description": "DAT-016 stock, pistol grip, front grip", "properties": { "slot": { "enum": ["stock", "pistolGrip", "frontGrip"] }, "modifiers": { "$ref": "#/$defs/modifiersGrip" } } },
        { "description": "DAT-016 handguard", "properties": { "slot": { "const": "handguard" }, "modifiers": { "$ref": "#/$defs/modifiersHandguard" } } },
        { "description": "DAT-016 optic", "properties": { "slot": { "const": "optic" }, "modifiers": { "$ref": "#/$defs/modifiersOptic" } } },
        { "description": "DAT-016 tactical: optional small ergonomics modifier (flashlight or laser); laser snapShotSpread (DAT-017)", "properties": { "slot": { "const": "tactical" }, "modifiers": { "$ref": "#/$defs/modifiersTactical" } } }
      ]
    },
    "modifiersMuzzle": { "type": "object", "properties": { "recoil": { "type": "number", "exclusiveMinimum": 0, "description": "factor" }, "flash": { "type": "number", "minimum": 0, "description": "factor on how far the muzzle flash reveals the shooter (DAT-016)" } }, "additionalProperties": false },
    "modifiersGrip": { "type": "object", "properties": { "ergonomics": { "type": "number", "description": "added" }, "recoil": { "type": "number", "exclusiveMinimum": 0, "description": "factor" } }, "additionalProperties": false },
    "modifiersHandguard": { "type": "object", "properties": { "ergonomics": { "type": "number" } }, "additionalProperties": false },
    "modifiersOptic": { "type": "object", "properties": { "shooterSpreadAtRange": { "type": "number" } }, "additionalProperties": false },
    "modifiersNone": { "type": "object", "additionalProperties": false },
    "modifiersTactical": { "type": "object", "properties": { "ergonomics": { "type": "number", "description": "small per-mod modifier (DAT-016, design decision 2026-11-24)" }, "snapShotSpread": { "type": "number", "description": "laser: multiplies shooter spread on snap shots (TAC-044)" } }, "additionalProperties": false },
    "calibre": {
      "properties": {
        "kind": { "const": "calibre" },
        "designation": { "type": "string" },
        "damage": { "type": "number", "exclusiveMinimum": 0 },
        "projectiles": { "type": "integer", "minimum": 1 },
        "recoilModifier": { "type": "number", "exclusiveMinimum": 0 },
        "roundWeightG": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": ["designation", "damage", "projectiles", "recoilModifier", "roundWeightG"]
    },
    "ammo": {
      "properties": {
        "kind": { "const": "ammo" },
        "calibre": { "$ref": "#/$defs/ref" },
        "ammoType": { "enum": ["fmj", "ap", "hp", "subsonic", "tracer", "buckshot", "slug"] },
        "damageModifier": { "type": "number", "exclusiveMinimum": 0 },
        "falloff": { "type": "number", "minimum": 0, "maximum": 1 },
        "falloffRangeTiles": { "type": "number", "exclusiveMinimum": 0 },
        "penetrationClass": { "type": "integer", "minimum": 0, "maximum": 6 },
        "subsonic": { "type": "boolean" },
        "spreadModifier": { "type": "number", "exclusiveMinimum": 0 },
        "tracer": { "type": "boolean", "description": "Less burst recoil spread (recoilSpreadModifier); does not reveal the shooter (ITM-003)" },
        "recoilSpreadModifier": { "type": "number", "exclusiveMinimum": 0, "description": "ITM-003 / TAC-047: multiplies burst recoil spread; tracer 0.85, default 1" },
        "bleedChanceModifier": { "type": "number", "exclusiveMinimum": 0 },
        "damageOverride": { "type": "number", "exclusiveMinimum": 0 },
        "projectilesOverride": { "type": "integer", "minimum": 1 }
      },
      "required": ["calibre", "ammoType", "damageModifier", "falloff", "falloffRangeTiles", "penetrationClass", "subsonic", "spreadModifier"]
    },
    "helmet": {
      "properties": {
        "kind": { "const": "helmet" },
        "armourClass": { "$ref": "#/$defs/armourClass" },
        "durability": { "type": "number", "exclusiveMinimum": 0 },
        "hearingPenalty": { "type": "boolean" },
        "visionConeDeg": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": ["armourClass", "durability", "hearingPenalty", "weightKg"]
    },
    "bodyArmour": {
      "properties": {
        "kind": { "const": "bodyArmour" },
        "armourClass": { "$ref": "#/$defs/armourClass" },
        "durability": { "type": "number", "exclusiveMinimum": 0 },
        "fillsVestSlot": { "type": "boolean" },
        "pouches": { "type": ["object", "null"], "properties": {
          "capacityKg": { "type": "number", "exclusiveMinimum": 0 },
          "maxMagazines": { "type": "integer", "minimum": 0 }, "maxGrenades": { "type": "integer", "minimum": 0 },
          "maxMedical": { "type": "integer", "minimum": 0 }, "maxOther": { "type": "integer", "minimum": 0 } } },
        "durabilityLossModifier": { "type": "number", "exclusiveMinimum": 0, "description": "ITM-011 / TAC-051: multiplies armour wear; ceramic 1.5" },
        "coversZones": { "type": "array", "items": { "enum": ["head", "thorax", "leftArm", "rightArm", "leftLeg", "rightLeg"] }, "description": "ITM-011: optional, unused in the first build (later limb armour)" },
        "apPenalty": { "type": "number", "minimum": 0 },
        "staminaPenalty": { "type": "number", "minimum": 0 },
        "concealable": { "type": "boolean" }
      },
      "required": ["armourClass", "durability", "fillsVestSlot", "weightKg"]
    },
    "vest": {
      "properties": {
        "kind": { "const": "vest" },
        "capacityKg": { "type": "number", "exclusiveMinimum": 0 },
        "maxMagazines": { "type": "integer", "minimum": 0 }, "maxGrenades": { "type": "integer", "minimum": 0 },
        "maxMedical": { "type": "integer", "minimum": 0 }, "maxOther": { "type": "integer", "minimum": 0 },
        "quiet": { "type": "boolean" }
      },
      "required": ["capacityKg", "maxMagazines", "maxGrenades", "maxMedical", "maxOther", "weightKg"]
    },
    "belt": {
      "properties": {
        "kind": { "const": "belt" },
        "capacityKg": { "type": "number", "exclusiveMinimum": 0 },
        "holsters": { "type": "integer", "minimum": 0, "description": "ITM-017 / DAT-005: each holster holds one pistol as an extra third weapon beside weapon1 and weapon2; it counts toward capacityKg, not toward the type limits" },
        "maxMagazines": { "type": "integer", "minimum": 0, "description": "ITM-014 / ITM-017: belt pouch type limits, design draft leather 2/2/1/1, padded 3/2/2/1, heavy 4/2/2/2 (magazines/grenades/medical/other)" },
        "maxGrenades": { "type": "integer", "minimum": 0, "description": "ITM-017, design draft 2" },
        "maxMedical": { "type": "integer", "minimum": 0 },
        "maxOther": { "type": "integer", "minimum": 0 }
      },
      "required": ["capacityKg", "holsters", "maxMagazines", "maxGrenades", "maxMedical", "maxOther", "weightKg"]
    },
    "backpack": {
      "properties": {
        "kind": { "const": "backpack" },
        "capacityKg": { "type": "number", "exclusiveMinimum": 0 },
        "extraAccessAp": { "type": "number", "minimum": 0 },
        "noSprint": { "type": "boolean" }
      },
      "required": ["capacityKg", "weightKg"]
    },
    "medical": {
      "properties": {
        "kind": { "const": "medical" },
        "treats": { "type": "array", "minItems": 1, "items": { "enum": ["lightBleeding", "heavyBleeding", "fracture", "pain", "hp", "limbAtZeroHp"] } },
        "zones": { "type": "array", "items": { "$ref": "#/$defs/zone" } },
        "apCost": { "type": "integer", "minimum": 1 },
        "uses": { "type": ["integer", "null"], "minimum": 1 },
        "hpPool": { "type": "number", "exclusiveMinimum": 0 },
        "hpPerUse": { "type": "number", "exclusiveMinimum": 0, "description": "Base HP per use before the Medical multiplier (TAC-066)" },
        "durationTurns": { "type": "integer", "minimum": 1 },
        "restoresToHp": { "type": "number", "minimum": 1 },
        "causesPain": { "type": "boolean" },
        "requiresMedical": { "type": "integer", "minimum": 1, "maximum": 100 },
        "backpackOnly": { "type": "boolean" }
      },
      "required": ["treats", "apCost", "weightKg"]
    },
    "barter": {
      "properties": {
        "kind": { "const": "barter" },
        "foundIn": { "type": "array", "items": { "type": "string" } },
        "barterClass": { "enum": ["tobacco", "alcohol", "valuable", "general"] },
        "refuelUnits": { "type": "integer", "minimum": 1, "description": "ITM-021 / DAT-025: fuel units this item refills into a ground vehicle tank when used (diesel canister 1)" },
        "contains": { "type": "array", "items": { "type": "object", "required": ["item", "chance"], "properties": { "item": { "$ref": "#/$defs/ref" }, "chance": { "type": "number", "minimum": 0, "maximum": 1 } } } }
      },
      "required": ["weightKg", "valueUsd", "rarity", "foundIn", "barterClass"]
    },
    "opItem": {
      "properties": {
        "kind": { "const": "opItem" },
        "foundIn": { "type": "array", "items": { "type": "string" } },
        "perFaction": { "type": "boolean" },
        "perPoi": { "type": "boolean" },
        "opEffect": { "type": ["object", "null"], "properties": {
          "type": { "enum": ["revealSquadPlan", "revealAdjacentSquads", "extendRadio", "demolition", "cutLock", "poiKey", "restockMedical", "restockAmmo"] } } },
        "handIn": { "type": "array", "items": { "type": "object", "required": ["receiver"], "properties": {
          "receiver": { "enum": ["issuingFaction", "enemiesOfIssuer", "factions", "rivalOfOwningPmc", "plantHolder", "cityHolder", "resistanceGroup", "krug"] },
          "factions": { "type": "array", "items": { "type": "string", "x-ref": "factions" } },
          "moneyUsd": { "type": "number", "minimum": 0 },
          "reputation": { "type": "number" },
          "dailyCap": { "type": "integer", "minimum": 1 },
          "effect": { "type": "object" } } } }
      },
      "required": ["weightKg", "foundIn"]
    },
    "magazine": {
      "description": "DAT-030, ITM-031: magazine or belt; an instance counts its rounds and holds one load type; refilled from loose ammunition only between fights",
      "properties": {
        "kind": { "const": "magazine" },
        "calibre": { "$ref": "#/$defs/ref" },
        "feedType": { "enum": ["pistol", "boxMagazine", "belt"] },
        "capacity": { "type": "integer", "minimum": 1 },
        "fits": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ref" } }
      },
      "required": ["calibre", "feedType", "capacity", "fits", "weightKg"]
    },
    "grenade": {
      "description": "ITM-032, TAC-079: thrown items (draft values in the item list)",
      "properties": {
        "kind": { "const": "grenade" },
        "effect": { "enum": ["frag", "smoke"] },
        "damage": { "type": "number", "minimum": 0 },
        "radiusTiles": { "type": "number", "exclusiveMinimum": 0 },
        "penetrationClass": { "type": "integer", "minimum": 0, "maximum": 6 },
        "durationTurns": { "type": ["integer", "null"], "minimum": 1 },
        "blocksSight": { "type": "boolean" },
        "loud": { "type": "boolean" }
      },
      "required": ["effect", "radiusTiles", "weightKg"]
    }
  }
}
