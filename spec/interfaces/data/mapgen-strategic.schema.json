{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data/mapgen-strategic.schema.json",
  "title": "Strategic map generation rules",
  "description": "Rules per stage of the strategic generation pipeline (spec STR-082..STR-091).",
  "version": "0.4.0",
  "$comment": "Named constants. Fields are optional until the content pass fills them with the design placeholders listed in the spec.",
  "type": "object",
  "properties": {
    "pipeline": { "type": "object", "description": "STR-082: stage order, maxAttempts" },
    "mapShape": { "enum": ["square", "hex"], "description": "STR-005/STR-082: square default, hex test option" },
    "width": { "type": "integer", "description": "STR-082, tiles, not set" },
    "height": { "type": "integer", "description": "STR-082, tiles, not set" },
    "land": { "type": "object", "description": "STR-083" },
    "capital": { "type": "object", "description": "STR-084" },
    "cities": { "type": "object", "description": "STR-085" },
    "industry": { "type": "object", "description": "STR-086" },
    "towns": { "type": "object", "description": "STR-087" },
    "roads": { "type": "object", "description": "STR-088" },
    "warState": { "type": "object", "description": "STR-089" },
    "krugMarkets": { "type": "object", "description": "STR-089: which town and city tiles in the contested belt get the krugMarket flag (count, spacing; not set)" },
    "start": { "type": "object", "description": "STR-090" },
    "validate": { "type": "object", "description": "STR-091" }
  },
  "additionalProperties": false
}
