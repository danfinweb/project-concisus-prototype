{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data/presets.schema.json",
  "title": "Soldier presets",
  "description": "Stats, loadout of item IDs, skills (spec MGT-001, MGT-021, MGT-037). The scav loadout and its price live in management-rules.scavLoadout (MGT-038).",
  "version": "0.4.0",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": ["id", "attributes"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "description": "Record ID, equals its key" },
      "attributes": { "type": "object", "description": "MGT-021: the eight attributes, 1-100" },
      "loadout": { "type": "object", "description": "DAT-005: slot to item ID" },
      "nerve": { "type": "integer", "minimum": 0, "maximum": 100, "description": "MGT-031" },
      "morale": { "type": "integer", "minimum": 0, "maximum": 100, "description": "MGT-008: per-soldier morale (default management-rules.moraleStart)" },
      "tier": { "enum": ["recruit", "regular", "veteran", "elite"], "description": "MGT-002: price tier (sets the salary, MGT-005)" }
    }
  }
}
