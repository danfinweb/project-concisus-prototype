{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data/mapgen-tactical.schema.json",
  "title": "Tactical map generation rules",
  "description": "Rules per stage of the tactical generation pipeline (spec TAC; stages from the workflow: terrain, roads, prefab placement, cover scatter, spawns and objectives, validate).",
  "version": "0.2.0",
  "$comment": "Named constants. Fields are optional until the content pass fills them with the design placeholders listed in the spec.",
  "type": "object",
  "properties": {
    "pipeline": { "type": "object", "description": "stage order and attempts" },
    "terrain": { "type": "object", "description": "terrain stage rules" },
    "roads": { "type": "object", "description": "roads stage rules" },
    "prefabs": { "type": "object", "description": "prefab placement tables per biome" },
    "cover": { "type": "object", "description": "cover scatter rules" },
    "spawns": { "type": "object", "description": "spawns and objectives" },
    "exits": { "type": "array", "description": "TAC-038: {count, condition: fuel | boatAtTurn | paidCrossing}" },
    "validate": { "type": "object", "description": "playability checks" }
  },
  "additionalProperties": false
}
