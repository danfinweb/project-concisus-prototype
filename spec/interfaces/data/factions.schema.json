{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data/factions.schema.json",
  "title": "Factions",
  "description": "The armed powers and their starting relations (spec GEN-004..GEN-018, STR-051, SAI-010).",
  "version": "0.2.0",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": ["id", "name", "kind"],
    "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "description": "Record ID, equals its key" },
      "name": { "type": "string", "description": "Display name" },
      "kind": { "enum": ["employer", "rivalPmc", "trader", "player", "influence", "civilian"], "description": "GEN-004" },
      "leader": { "type": "string", "description": "GEN-008, leader VIP or name" },
      "patron": { "type": "string", "x-ref": "factions", "description": "GEN-005, patron faction or influence" },
      "startRelations": { "type": "object", "description": "GEN-007 / STR-051: faction id → -100..100" },
      "doctrine": { "type": "string", "x-ref": "ai/doctrines", "description": "SAI-010" },
      "measures": { "type": "array", "description": "STR-070, desperate measures this faction may take" },
      "capitalHolder": { "type": "boolean", "description": "STR-007" },
      "deniableChance": { "type": "number", "minimum": 0, "maximum": 1, "description": "MGT-050" },
      "disownChance": { "type": "number", "minimum": 0, "maximum": 1, "description": "MGT-050" }
    }
  }
}
