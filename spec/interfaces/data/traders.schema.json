{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data/traders.schema.json",
  "title": "Traders",
  "description": "Trader stock and barter rates (spec MGT-039/MGT-040, ITM-022/ITM-023).",
  "version": "0.2.0",
  "$comment": "Named constants. Fields are optional until the content pass fills them with the design placeholders listed in the spec.",
  "type": "object",
  "properties": {
    "traders": { "type": "array", "description": "MGT-039: {id, faction, locationKind, stockByStanding}" },
    "cityBarterRate": { "type": "number", "minimum": 0, "maximum": 1, "description": "ITM-022, design 0.5" },
    "krugBarterRate": { "type": "number", "minimum": 0, "maximum": 1, "description": "ITM-022, design 0.7" },
    "krugPremiumRate": { "type": "number", "minimum": 0, "maximum": 1, "description": "ITM-022, design 1.0 for tobacco, alcohol, valuables" },
    "barterDealsMin": { "type": "integer", "description": "ITM-023, design 1" },
    "barterDealsMax": { "type": "integer", "description": "ITM-023, design 3" },
    "barterDealValueRate": { "type": "number", "description": "ITM-023, design 1.0" },
    "krugPriceFluctuation": { "type": "object", "description": "MGT-040" }
  },
  "additionalProperties": false
}
