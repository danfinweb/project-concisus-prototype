{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tactical_commands.schema.json",
  "title": "Tactical commands",
  "description": "Commands a tactical controller returns for an activation: the same set a player issues. The tactical layer validates and resolves each; illegal commands are rejected. Spec: TAI-005, TAI-006, TAI-016, TAC-005..TAC-074.",
  "version": "0.3.0",
  "x-producer": "modules/tactical-ai",
  "x-consumers": ["modules/tactical"],
  "type": "object",
  "required": ["commands"],
  "properties": {
    "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } },
    "blackboardWrites": { "type": "array", "items": { "type": "object" } },
    "log": { "type": "array", "description": "Decision log: turn, unit, chosen command, top-N options with survival, goal, fit and coordination scores (TAI-016)", "items": { "type": "object" } }
  },
  "$defs": {
    "command": {
      "type": "object", "required": ["type"],
      "properties": {
        "type": { "enum": ["activate", "pass", "move", "turn", "changeStance", "vault", "climb", "shoot", "reload", "swapWeapon", "throwGrenade", "setReaction", "holdOverwatch", "useItem", "dropBackpack", "pickUpBackpack", "search", "pickUp", "cutLock", "placeCharge", "restrainVip", "liftBody", "putDownBody", "leaveMap", "endActivation"] },
        "mode": { "enum": ["carry", "drag"], "description": "liftBody (TAC-074)" },
        "magazine": { "type": "string", "description": "reload: magazine item instance" },
        "shells": { "type": "integer", "minimum": 1, "description": "reload, tube-fed: shells to load (partial reload)" },
        "unit": { "type": "string" },
        "path": { "type": "array", "items": { "type": "object" } },
        "stance": { "enum": ["upright", "crouched", "prone"] },
        "sprint": { "type": "boolean" },
        "facing": { "type": "number" },
        "target": { "type": "string" },
        "tile": { "type": "object" },
        "fireMode": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "const": "auto" }] },
        "aimSteps": { "type": "integer", "minimum": 0 },
        "reaction": { "enum": ["fire", "takeCover", "hold"] },
        "item": { "type": "string" },
        "sourceSlot": { "type": "string" },
        "zone": { "type": "string" },
        "exit": { "type": "string" }
      }
    }
  }
}
