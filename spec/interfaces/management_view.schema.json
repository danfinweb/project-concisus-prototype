{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "management_view.schema.json",
  "title": "Management view",
  "description": "What other modules may read of the Management-owned slices: reputation per faction with the derived standing, the contracts with their status, the PMC's funds, and the soldier data Strategic needs (tactical map requests, VIP morale shock, recon and pilot checks). Produced after each batch of management_requests and on load. Spec: MGT-001, MGT-042, MGT-053, MGT-054, MGT-070, MGT-072, STR-017, STR-047, STR-093, SAI-013.",
  "version": "0.3.0",
  "x-producer": "modules/management",
  "x-consumers": ["modules/strategic"],
  "type": "object",
  "required": ["time", "reputation", "contracts", "funds", "roster"],
  "additionalProperties": false,
  "properties": {
    "time": { "type": "object", "required": ["day", "hour"], "properties": { "day": { "type": "integer", "minimum": 1 }, "hour": { "type": "integer", "minimum": 0, "maximum": 23 } } },
    "reputation": {
      "type": "object",
      "description": "Faction ID (every non-player faction, GEN-004) → reputation with the player",
      "additionalProperties": {
        "type": "object", "required": ["value", "standing"], "additionalProperties": false,
        "properties": {
          "value": { "type": "integer", "minimum": -100, "maximum": 100, "description": "MGT-053 (range repMin..repMax)" },
          "standing": { "$ref": "#/$defs/standing" }
        }
      }
    },
    "contracts": {
      "type": "array",
      "description": "Every offered or signed contract, plus those ended since the previous view (MGT-042, MGT-072)",
      "items": { "$ref": "#/$defs/contract" }
    },
    "funds": {
      "type": "object", "required": ["balanceUsd", "debtsUsd"], "additionalProperties": false,
      "properties": {
        "balanceUsd": { "type": "number", "minimum": 0, "description": "economy balance (MGT-070); never negative" },
        "debtsUsd": { "type": "number", "minimum": 0, "description": "Sum of open debts (MGT-070); 0 when there are none" }
      }
    },
    "roster": {
      "type": "array",
      "description": "Every soldier whose status is not dead (MGT-001, MGT-072): what Strategic copies into tactical_map_request units[] and uses for STR-024, STR-034, STR-047",
      "items": { "$ref": "#/$defs/soldier" }
    }
  },
  "$defs": {
    "soldier": {
      "type": "object", "required": ["id", "status", "rank", "morale", "attributes", "perks"], "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "Roster ID (tactical_map_request units[].id)" },
        "status": { "enum": ["active", "mia", "captured"], "description": "MGT-001 (dead soldiers are on the memorial, not listed)" },
        "rank": { "enum": ["recruit", "regular", "veteran", "elite"], "description": "MGT-074" },
        "morale": { "type": "number", "minimum": 0, "maximum": 100, "description": "MGT-008" },
        "attributes": { "type": "object", "description": "The eight attributes by name (MGT-021)", "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 100 } },
        "nerve": { "type": "number", "description": "MGT-031" },
        "wounds": { "type": "object", "description": "MGT-001 wounds: zoneHp and conditions in the battle_result shapes", "properties": { "zoneHp": { "type": "object" }, "conditions": { "type": "array", "items": { "type": "object" } } }, "additionalProperties": false },
        "equipment": { "type": "object", "description": "Slot → item instance, the tactical_map_request units[].equipment shape (MGT-001)" },
        "perks": { "type": "array", "items": { "type": "string" }, "description": "Perk IDs the soldier has (management-rules perks[].id, MGT-009); tactical_map_request units[].perks (TAC-096)" }
      }
    },
    "standing": { "enum": ["hostile", "unfriendly", "neutral", "friendly", "trusted"], "description": "MGT-054, derived from value by management-rules standingThresholds" },
    "contract": {
      "type": "object", "required": ["id", "employer", "status"], "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "employer": { "type": "string", "x-ref": "factions" },
        "targetFaction": { "type": ["string", "null"], "x-ref": "factions" },
        "status": { "enum": ["offered", "signed", "ended"] },
        "endReason": { "enum": ["completed", "deadline", "employerDefault", "factionDissolved", "taken", "allFailed"], "description": "Set when status is ended: contractEnded reason, or allFailed when every mission failed (MGT-048, MGT-052)" },
        "disowned": { "type": "boolean", "description": "MGT-050: the employer disowned the contract (still paid, no reputation gain)" },
        "deadline": { "type": "object", "required": ["day", "hour"], "properties": { "day": { "type": "integer", "minimum": 1 }, "hour": { "type": "integer", "minimum": 0, "maximum": 23 } } },
        "pay": { "type": "number", "minimum": 0, "description": "MGT-046" },
        "advance": { "type": "number", "minimum": 0, "description": "MGT-047" },
        "missions": {
          "type": "array",
          "items": {
            "type": "object", "required": ["key", "missionId", "outcome"], "additionalProperties": false,
            "properties": {
              "key": { "type": "string", "description": "contractOffer missions[].key (MGT-042)" },
              "missionId": { "type": "string", "x-ref": "missions" },
              "pay": { "type": "number", "minimum": 0, "description": "MGT-046 mission pay" },
              "location": { "type": "string" },
              "outcome": { "enum": ["open", "success", "failure"], "description": "MGT-044" }
            }
          }
        }
      }
    }
  }
}
